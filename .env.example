# Copy this file to .env.local (local development) and set the same values in Vercel
# under Project Settings → Environment Variables (production).
ATLAS_USERNAME=choose-a-username
ATLAS_PASSWORD=choose-a-strong-password
# Long random string used to sign session cookies, e.g. output of: openssl rand -hex 32
ATLAS_SESSION_SECRET=replace-with-a-long-random-string
# Optional. Production on Vercel authenticates the AI Gateway with OIDC.
# Set this only if you want "Write the report" to call the model from local dev.
# AI_GATEWAY_API_KEY=
